APP_NAME="Personal Gallery"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gallery.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gallery
DB_USERNAME=gallery
DB_PASSWORD=
DB_COLLATION=utf8mb4_persian_ci

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- gallery ---
# Read-only mount of the storage box. Nothing is ever written there.
GALLERY_ROOT=/mnt/gallery-storage
# Refuse to work when GALLERY_ROOT is not a mount point (protects the DB when the mount is down).
GALLERY_REQUIRE_MOUNT=true
# Secret for signed media URLs (php -r "echo bin2hex(random_bytes(32));"). Changing it makes old media links invalid.
GALLERY_URL_KEY=
# Minutes a directory listing is trusted before the folder is read again.
GALLERY_LISTING_TTL=720
GALLERY_THUMB_SIZE=480
GALLERY_THUMB_QUALITY=72
# Files read from the storage box at the same time (thumbnails + scan job).
GALLERY_READ_SLOTS=2
GALLERY_TZ=Asia/Tehran
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
GEOCODE_AGENT="PersonalGallery/1.0 (self-hosted photo album)"
